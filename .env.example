# =============================================================================
# Pavann Server - Local Development Environment
# =============================================================================
# These values are safe placeholders for running `pnpm dev` locally.
# Replace any of them with real values to enable the corresponding feature.
# =============================================================================

NODE_ENV=development
PORT=5050
BASE_URL=http://localhost:5050

# Database (matches compose.yaml dev profile)
DATABASE_URL=postgresql://postgres:postgres@localhost:5454/lauracg882_db

# JWT
JWT_SECRET=local-dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_LENGTH=64
REFRESH_TOKEN_EXPIRES_DAYS=30

# Redis (matches compose.yaml dev profile)
REDIS_HOST=localhost
REDIS_PORT=22386

# Super Admin (seeded on first boot)
SUPER_ADMIN_EMAIL=admin@pavann.local
SUPER_ADMIN_PASS=ChangeMe123!

# Mail (any placeholder works for local dev; mail send will be skipped/fail
# gracefully without crashing the server)
MAIL_USER=dev@pavann.local
MAIL_PASS=dev-pass
MAIL_PORT=587
MAIL_HOST=localhost
LOGO_URL=https://example.com/logo.png

# AWS S3 (fill these in to enable file uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dev-access-key
AWS_SECRET_ACCESS_KEY=dev-secret-key
AWS_S3_BUCKET_NAME=pavann-dev-bucket

# Twilio (placeholders; Twilio is only loaded if TwilioModule is imported)
TWILIO_ACCOUNT_SID=dev-account-sid
TWILIO_AUTH_TOKEN=dev-auth-token
TWILIO_PHONE_NUMBER=+15555555555

# Stripe (placeholders; subscribe endpoints will fall back to direct activation)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=
PLATFORM_FEE_PERCENT=10

# Firebase (placeholders; FCM init will not be required)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
SIGNUP_MAX_ATTEMPTS=3
SIGNUP_WINDOW_MS=3600000
OTP_MAX_ATTEMPTS=5
OTP_WINDOW_MS=900000
PASSWORD_RESET_MAX_ATTEMPTS=3
PASSWORD_RESET_WINDOW_MS=3600000

# AI
AI_SPACE_OPTIMIZATION_URL=http://localhost:8000

# Frontend
FRONTEND_URL=http://localhost:3000

# Cache
ENABLE_CACHE=false