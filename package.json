{
  "name": "NestJs_Temp",
  "version": "1.0.0",
  "description": "NestJS project template with Prisma, JWT, Socket.io, and S3 integration.",
  "author": "Rafi_Sharkar",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "npx prisma generate --schema ./prisma/schema/schema.prisma && npx nest build",
    "start": "npx prisma generate --schema ./prisma/schema/schema.prisma && npx prisma migrate deploy --schema ./prisma/schema/schema.prisma && node dist/src/main",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --ignore-path .prettierignore --check \"**/*.+(js|ts|json)\"",
    "format:fix": "prettier --ignore-path .prettierignore --write \"**/*.+(js|ts|json)\"",
    "ci:check": "pnpm format && pnpm lint && pnpm db:validate && pnpm build && pnpm start",
    "ci:fix": "pnpm format:fix",
    "prisma": "npx prisma",
    "db:push": "npx prisma db push --schema ./prisma/schema/schema.prisma",
    "db:pull": "npx prisma db pull --schema ./prisma/schema/schema.prisma",
    "db:generate": "npx prisma generate --schema ./prisma/schema/schema.prisma",
    "db:reset": "npx prisma migrate reset --schema ./prisma/schema/schema.prisma",
    "db:migrate": "npx prisma migrate dev --schema ./prisma/schema/schema.prisma",
    "db:deploy": "npx prisma migrate deploy --schema ./prisma/schema/schema.prisma",
    "db:studio": "npx prisma studio --schema ./prisma/schema/schema.prisma",
    "db:validate": "npx prisma validate --schema ./prisma/schema/schema.prisma",
    "db:format": "npx prisma format --schema ./prisma/schema/schema.prisma",
    "commit": "cz",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.946.0",
    "@fastify/cookie": "^11.0.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/platform-socket.io": "^11.1.9",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.9",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.1",
    "bullmq": "^5.65.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "firebase-admin": "^13.10.0",
    "he": "^1.2.0",
    "i": "^0.3.7",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mime-types": "^3.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.11",
    "openai": "^6.46.0",
    "passport": "^0.7.0",
    "passport-firebase-jwt": "^1.2.1",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "stripe": "^20.4.0",
    "twilio": "^5.12.0",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@jest/globals": "^30.4.1",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/testing": "^11.1.21",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/he": "^1.2.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/mime-types": "^3.0.1",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^7.0.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^7.2.0",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prisma": "^7.1.0",
    "semantic-release": "^25.0.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  }
}
